// Connexion à Supabase via le CDN SDK
import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm'

const supabase = createClient('TA_SUPABASE_URL', 'TA_CLE_ANONYME_API')

// Fonction d'envoi d'un nouveau contenu
async function uploadNewPost(title, price, mediaType, teaserFile, fullFile) {
    // 1. Upload du teaser dans le Bucket Storage 'teasers'
    const { data: teaserData, error: teaserErr } = await supabase.storage
        .from('teasers')
        .upload(`teaser_${Date.now()}_${teaserFile.name}`, teaserFile)

    // 2. Upload du média complet dans le Bucket Storage 'protected-content'
    const { data: fullData, error: fullErr } = await supabase.storage
        .from('protected-content')
        .upload(`full_${Date.now()}_${fullFile.name}`, fullFile)

    if (teaserErr || fullErr) {
        console.error("Erreur lors de l'upload :", teaserErr || fullErr)
        return
    }

    // 3. Récupération des URLs publiques et enregistrement en BDD
    const teaserUrl = supabase.storage.from('teasers').getPublicUrl(teaserData.path).data.publicUrl
    const fullMediaUrl = supabase.storage.from('protected-content').getPublicUrl(fullData.path).data.publicUrl

    const { error: dbErr } = await supabase.from('posts').insert([{
        title: title,
        price: parseFloat(price),
        media_type: mediaType,
        teaser_url: teaserUrl,
        full_media_url: fullMediaUrl
    }])

    if (!dbErr) {
        alert("Publication ajoutée avec succès !")
    }
}
